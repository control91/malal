{
  "name": "malal-platform-assets",
  "private": true,
  "description": "Front-end build tooling (Tailwind CSS + vendored JS libraries) for the Django platform.",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -i assets/css/main.css -o static/css/main.css --minify",
    "watch:css": "tailwindcss -i assets/css/main.css -o static/css/main.css --minify --watch",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.17.5",
    "@alpinejs/focus": "^3.17.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "alpinejs": "^3.17.5",
    "htmx.org": "^2.0.11",
    "lucide-static": "^1.61.0",
    "tailwindcss": "^4.3.3",
    "trix": "^2.1.19"
  }
}
