# ---------------------------------------------------------------------------
# Copy to .env, then: php artisan key:generate. NEVER commit the real .env.
# ---------------------------------------------------------------------------
APP_NAME=MALAL
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://exemple.gn
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Conakry
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Reverse proxies allowed to set X-Forwarded-* (nginx container / load balancer)
TRUSTED_PROXIES=*

# Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=malal
DB_USERNAME=malal
DB_PASSWORD=change-me

# Sessions, cache, queues (Redis)
SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.exemple.gn
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@exemple.gn"
MAIL_FROM_NAME="${APP_NAME}"

# Uploaded media: local volume by default; S3-compatible storage with MEDIA_DISK_DRIVER=s3
MEDIA_DISK_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Extra image origin allowed by the CSP (e.g. https://cdn.exemple.gn when using S3/CDN)
CSP_IMG_EXTRA=

# Security
CSP_ENABLED=true
HSTS_SECONDS=2592000
# Optional IP allow-list for /admin (comma separated IPs / CIDR)
ADMIN_ALLOWED_IPS=
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=1800
FORM_RATE_LIMIT=5
FORM_RATE_WINDOW=600
FORM_MIN_SUBMIT_SECONDS=3
ANALYTICS_ENABLED=true

# Server-side rendering (Node SSR server)
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714
# The SSR bundle lives in the ssr container, not next to PHP.
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=false

VITE_APP_NAME="${APP_NAME}"
