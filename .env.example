# ---------------------------------------------------------------------------
# Copy to .env and adapt. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=exemple.gn,www.exemple.gn,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://exemple.gn,https://www.exemple.gn
SITE_URL=https://exemple.gn
# Unguessable path for the fallback Django admin
DJANGO_ADMIN_URL=gestion-secours-x7k2/
# Optional: restrict /dashboard/ and the Django admin to these IPs/networks (comma separated)
ADMIN_ALLOWED_IPS=
# Number of trusted reverse proxies in front of Gunicorn (nginx = 1)
PROXY_COUNT=1
DJANGO_ADMINS_EMAILS=tech@exemple.gn
LOG_LEVEL=INFO

# Database (docker compose builds DATABASE_URL from these)
POSTGRES_DB=malal
POSTGRES_USER=malal
POSTGRES_PASSWORD=change-me-too
DATABASE_URL=postgres://malal:change-me-too@db:5432/malal

# Cache, sessions throttling & Celery broker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemple.gn
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MALAL <no-reply@exemple.gn>

# Media storage: local volume by default, S3-compatible when USE_S3=true
USE_S3=false
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CUSTOM_DOMAIN=
# Add the S3/CDN origin here so the CSP allows its images, e.g. https://cdn.exemple.gn
CSP_IMG_EXTRA=

# HTTPS (TLS terminated by nginx or an upstream proxy)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=2592000

# Security / anti-spam
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=0.5
FORM_RATE_LIMIT=5/600
FORM_MIN_SUBMIT_SECONDS=3
ANALYTICS_ENABLED=true

HTTP_PORT=80
